{
  "name": "shotlist.dev",
  "type": "module",
  "version": "0.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build-example.mjs && astro dev",
    "build": "node scripts/check-examples.mjs && node scripts/build-example.mjs && astro build && node scripts/compress-html.mjs && node scripts/check-spacing.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spacing": "node scripts/check-spacing.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "shots": "shotlist --all --install"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "astro-seo": "^1.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "shotlist": "^0.4.1"
  }
}
