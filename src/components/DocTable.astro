---
/**
 * A reference table.
 *
 * Cells are written as HTML so a key can carry `<code>` without every page repeating the
 * markup for it. The content is authored here, never supplied by a reader.
 *
 * Below `sm` the columns stack, because a three-column reference table cannot be read in
 * 327 pixels by any amount of sideways scrolling — the row is the unit worth keeping
 * together, not the column. The roles are written out because changing `display` takes
 * the table semantics with it, and a stacked row should still be a row.
 */
interface Props {
  head: string[]
  rows: string[][]
  class?: string
}

const { head, rows, class: className = '' } = Astro.props
---

<!-- Scrolls itself rather than pushing the page sideways, once there is room to scroll. -->
<div class:list={['mt-6 sm:overflow-x-auto', className]}>
  <table role="table" class="doc-table w-full border-collapse text-left text-sm sm:min-w-lg">
    <thead>
      <tr role="row" class="border-b border-rule-strong">
        {
          head.map((cell) => (
            <th
              role="columnheader"
              class="py-2 pr-6 font-mono text-[0.6875rem] tracking-wider text-muted uppercase"
            >
              {cell}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr role="row" class="border-b border-rule last:border-0">
            {row.map((cell, i) => (
              <td
                role="cell"
                data-label={head[i] ?? ''}
                class="py-2.5 pr-6 align-top leading-relaxed text-muted"
                set:html={cell}
              />
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Keys and values are the vocabulary these tables are about. */
  td :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink);
  }

  /*
   * A key that links somewhere takes the link color, and it has to be said here.
   * `global.css` colors links in `@layer base`, and an unlayered rule — which every
   * scoped style in a component is — outranks any layer whatever its specificity. The
   * rule above would win from two selectors away.
   */
  td :global(a code) {
    color: var(--color-mark);
  }

  @media (width < 40rem) {
    .doc-table,
    .doc-table tbody,
    .doc-table tr,
    .doc-table td {
      display: block;
    }

    /* The header moves onto each cell, so the row of labels has nothing left to say. */
    .doc-table thead {
      display: none;
    }

    .doc-table tr {
      padding-block: 0.875rem;
    }

    .doc-table td {
      padding: 0;
    }

    /* The first cell is the key, and reads as the row's heading. */
    .doc-table td:first-child {
      color: var(--color-ink);
      font-weight: 500;
    }

    .doc-table td + td {
      margin-top: 0.375rem;
    }

    /* Every later cell carries the column name it lost. */
    .doc-table td + td[data-label]:not([data-label=''])::before {
      content: attr(data-label) ' ';
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
  }
</style>
