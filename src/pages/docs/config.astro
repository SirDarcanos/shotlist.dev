---
import Docs from '../../layouts/Docs.astro'
import DocTable from '../../components/DocTable.astro'
import RecipeCard from '../../components/RecipeCard.astro'

const serve = `site:
  url: http://localhost:3000
  serve: npm run dev`

const serveLong = `site:
  serve:
    command: npm run dev
    ready: 3000 # a http(s) URL, a port, or { log: <pattern> }
    cwd: apps/web # resolved from the config file's directory
    env: { PORT: '3000' }
    timeout: 30000`

const sessions = `site:
  sessions:
    admin: .shotlist/admin.json
    reader:
      path: .shotlist/reader.json
      verify: '[data-signed-in]'`

const imageFormat = `image:
  format: webp
  quality: 90`

const style = `style:
  color: '#DC2626' # boxes, arrows, discs
  canvas: '#FFFFFF' # fills space added around the image for labels
  box: { width: 6, radius: 10, pad: 8 }
  arrow: { shaft: 6, headHalf: 19, headLength: 38 }
  label:
    font: 'Arial, Helvetica, sans-serif'
    weight: 700
    size: 44
    fill: '#FFFFFF' # glyph fill
    stroke: '#DC2626' # outline around the glyphs; defaults to \`color\`
    strokeWidth: 6 # centred on the outline, so half is under the fill
    gap: 40 # distance from the box
    fontUrl: # optional stylesheet to load before drawing
  number:
    radius: 26
    size: 40
    fill: '#DC2626' # the disc; defaults to \`color\`
    text: '#FFFFFF' # the numeral
  mask:
    fill: '#94A3B8' # what a masked region is painted with`

const fontFile = `style:
  label:
    fontUrl: fonts/Inter-Bold.woff2 # the file itself
    font: 'Inter'
    weight: 700`

const localFont = `style:
  label:
    fontUrl: fonts/inter.css # read from disk, fonts and all
    font: 'Inter'`

const font = `style:
  label:
    fontUrl: https://fonts.googleapis.com/css2?family=Inter:wght@700&display=swap
    font: 'Inter, Arial, sans-serif'`
---

<Docs
  title="Configuration"
  description="Every key in shotlist.config.yaml: where the site is, how it is started, and every drawing constant."
>
  <h1 class="text-4xl font-extrabold">Configuration</h1>

  <p class="mt-6 leading-relaxed text-(--muted)">
    One <code>shotlist.config.yaml</code> in the project root. Every path in it resolves from its own
    directory, not from wherever the command was run.
  </p>

  <DocTable
