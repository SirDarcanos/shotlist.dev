---
import Base from '../layouts/Base.astro'
import RecipeCard from '../components/RecipeCard.astro'
import CommandTabs from '../components/CommandTabs.astro'
import { heroRecipe, minimalRecipe, configExample } from '../lib/recipes'

/**
 * The rest of what it does, one line each.
 *
 * The page's job is to say what is here and hand over; anything that needs a second
 * sentence needs the docs page it links to instead.
 */
/** The one command someone reading this page is here to copy. */
const install = [
  { label: 'npm', code: 'npm i -D shotlist playwright' },
  { label: 'pnpm', code: 'pnpm add -D shotlist playwright' },
  { label: 'yarn', code: 'yarn add -D shotlist playwright' },
]

const rest = [
  {
    key: 'site.serve',
    title: 'Start the site it shoots',
    body: 'Names the command, waits until it answers, stops it afterwards — and uses a server you already have running rather than fighting it for the port.',
    href: '/docs/config',
  },
  {
    key: 'mask',
    title: 'Paint over a region',
    body: 'A clock, a live total, a face. The rest of the shot stays under drift detection instead of the whole image opting out.',
    href: '/docs/callouts#masking',
  },
  {
    key: 'check.ignore',
    title: 'Check a shot whose subject changes',
    body: 'Leaves a region out of the comparison but shoots it as it is — and still reports the box moving, resizing or rendering nothing.',
    href: '/docs/check',
  },
  {
    key: '--diff',
    title: 'Write a diff image',
    body: 'A committed, re-shot and changed-pixels three-up per drifted shot. --json reports the run for something other than a person.',
    href: '/docs/check',
  },
  {
    key: 'use:',
    title: 'Share setup, and drive a shot from a list',
    body: 'A macro for the steps every recipe repeats, a data file for the rows to walk. One recipe, one screenshot per order.',
    href: '/docs/macros',
  },
  {
    key: 'source: file',
    title: 'Annotate an image you already have',
    body: 'For a screen no script can reach — behind a sign-in you cannot automate, or an extension. Same callouts, same install.',
    href: '/docs/recipes',
  },
  {
    key: '--untrusted',
    title: 'Run a config you did not write',
    body: 'A shot list only opens its own site and never reads a .env, in every mode. In CI, one flag takes away the rest.',
    href: '/docs/security',
  },
  {
    key: 'SKILL.md',
    title: 'Editor and agent support',
    body: 'JSON Schemas generated from the same definitions that validate a run, and a skill that teaches an agent to write a query worth keeping.',
    href: '/docs/running-shotlist',
  },
]

const anatomy = [
  {
    n: 1,
    key: 'setup:',
    title: 'Drive the page to a state',
    body: 'Twenty verbs — click, fill, hover, select, wait, and the rest — run against your site until the thing you want to photograph is on screen. Steps shared between shots go in a macro.',
  },
  {
    n: 2,
    key: 'clip:',
    title: 'Clip a region of it',
    body: 'The whole viewport, the whole page, or whatever an element query finds: the smallest box holding a name and an amount, a modal card climbed out of its overlay.',
  },
  {
    n: 3,
    key: 'callouts:',
    title: 'Draw on top',
    body: 'Say which side of a mark a label belongs on. shotlist works out the position, grows the canvas when a label needs room outside the shot, and moves one that would collide with another.',
  },
]
---

<Base
  title="shotlist — annotated UI screenshots, described as data"
  description="shotlist opens your running site, drives it to the state you describe, clips a region, draws the callouts, and writes the image where you want it. Each screenshot is a YAML file."
  bare
>
  <!-- Hero. Grid for the surface; the blooms are the dark section's alone. -->
  <section class="relative overflow-hidden">
    <div class="paper-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div
      class="relative mx-auto grid min-w-0 max-w-6xl items-center gap-12 px-6 pt-16 pb-24 sm:pt-24 sm:pb-32 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16"
    >
      <div>
        <h1 class="text-[clamp(2.6rem,6.5vw,4.25rem)] leading-[1.02] font-extrabold">
          Annotated UI screenshots, <span class="text-mark">described as data</span>.
        </h1>

        <p class="mt-5 font-mono text-xs tracking-wide text-(--muted)">
          <span class="text-mark">MIT</span> · Node 20+ · driven by Playwright
        </p>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-(--muted)">
          shotlist opens your running site, drives it to the state you describe, clips a region,
          draws the callouts on it, and writes the image where you want it. Each screenshot is a
          YAML file. There is no per-screenshot code.
        </p>

        <CommandTabs commands={install} class="mt-6 max-w-md" />
      </div>

      <figure class="min-w-0 lg:-mr-4">
        <RecipeCard code={heroRecipe} file="screenshots/recipes/recipe-anatomy.yaml" />
        <figcaption class="mt-4 flex items-start gap-2.5 text-sm text-(--muted)">
          <span class="mt-1.5 inline-block h-px w-6 shrink-0 bg-mark" aria-hidden="true"></span>
          <span>
            The recipe for a shot of this site's own docs page. Nothing here is a simplification —
            it is the whole file.
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Anatomy -->
  <section class="band-wash">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-28">
      <h2 class="max-w-2xl text-[clamp(1.9rem,3.6vw,2.6rem)] leading-tight font-extrabold">
        What a recipe contains
      </h2>
      <p class="mt-4 max-w-2xl text-(--muted)">
        Three sections, read top to bottom: drive the page to a state, clip a region of it, draw on
        what the clip contains.
      </p>

      <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          anatomy.map((item) => (
            <li>
              <div class="flex items-center gap-3">
                <span
                  class="grid size-8 shrink-0 place-items-center rounded-full bg-mark font-mono text-sm font-medium text-paper"
                  aria-hidden="true"
                >
                  {item.n}
                </span>
                <code class="font-mono text-sm font-medium text-mark">{item.key}</code>
              </div>
              <h3 class="mt-5 text-xl font-bold">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-(--muted)">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!--
    The constraint, inverted. The page has alternated two light tones by here, and this is
    the one section that argues rather than explains — it gets to interrupt. A dark ground
    also carries far more of the red before it registers as colour, so the blooms are the
    strongest on the page.
  -->
  <section class="tone-dark relative overflow-hidden">
    <div class="paper-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="glow"
      style="--glow-at: 14% 0%; --glow-size: 54rem 30rem; --glow-strength: 26%"
      aria-hidden="true"
    >
    </div>
    <div
      class="glow"
      style="--glow-at: 92% 100%; --glow-size: 44rem 26rem; --glow-strength: 20%"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto grid max-w-6xl gap-12 px-6 py-24 sm:py-28 lg:grid-cols-2 lg:items-center lg:gap-16"
    >
      <div>
        <h2 class="text-[clamp(1.9rem,3.6vw,2.6rem)] leading-tight font-extrabold">
          A recipe is data
        </h2>
        <div class="mt-8 space-y-5 leading-relaxed text-(--muted)">
          <p>
            A recipe is a YAML file, and nothing in it runs. There is no JavaScript step, and no
            plugin hook that turns into one.
          </p>
          <p>
            Twenty verbs drive the page. A query language says what to point at — a row in a table,
            a modal, the amount in a cell.
          </p>
          <p>
            A recipe can be read without knowing the codebase, and fixed by whoever notices it
            broke.
          </p>
        </div>
      </div>

      <div class="min-w-0">
        <RecipeCard code={minimalRecipe} file="screenshots/recipes/order-row.yaml" />
        <p class="mt-4 text-sm text-(--muted)">
          Find an element by CSS, role, label or text, then narrow it down until one thing matches.
        </p>
      </div>
    </div>
  </section>

  <!-- Staleness -->
  <section class="band-wash">
    {
      /*
      The terminal sits on the left here, the only section that leads with its artwork.
      Done with `order` rather than by swapping the markup: stacked on a phone the
      heading has to come first, or the section opens on output nothing has explained yet.
    */
    }
    <div
      class="mx-auto grid max-w-6xl gap-12 px-6 py-24 sm:py-28 lg:grid-cols-2 lg:items-center lg:gap-20"
    >
      <div class="lg:order-2">
        <h2 class="text-[clamp(1.9rem,3.6vw,2.6rem)] leading-tight font-extrabold">
          Checking screenshots against the site
        </h2>
        <div class="mt-6 space-y-5 leading-relaxed text-(--muted)">
          <p>
            <code class="font-mono text-sm text-ink">shotlist --check</code> re-shoots every recipe, compares
            each against the committed image, and exits non-zero if any of them moved. In CI that makes
            a screenshot which no longer matches the site a failing build.
          </p>
          <p>
            Nothing else reports it. When an interface changes, the committed image goes on
            rendering exactly as before; it is only no longer true.
          </p>
          <p>
            The parts a recipe does not decide — a clock, a live figure — are named rather than
            tolerated, so the check is worth reading. One running on a different machine from the
            one that took the images says so before it says anything else.
          </p>
        </div>
      </div>

      <div class="min-w-0 lg:order-1">
        <div
          class="overflow-hidden rounded-lg border border-(--rule-strong) bg-white p-5 font-mono text-[0.8125rem] leading-relaxed sm:p-6"
        >
          <p class="text-(--muted)">$ npx shotlist --check</p>
          <p class="mt-3 text-(--muted)">
            <span class="text-(--muted)">same</span>&nbsp;&nbsp;&nbsp;&nbsp; order-row
          </p>
          <p class="text-(--muted)">
            <span class="text-(--muted)">same</span>&nbsp;&nbsp;&nbsp;&nbsp; modal-detail
          </p>
          <p class="font-medium text-mark">CHANGED&nbsp; billing-plan — 3.41% of pixels differ</p>
          <p class="text-(--muted)">
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; committed:
            content/guide/images/billing-plan.png
          </p>
          <p class="mt-3 text-ink">1 of 3 need attention</p>
        </div>
      </div>
    </div>
  </section>

  <!--
    Everything else, one line each. Plain ground: the section before it is a wash and the
    one after is the red, so a third tone here would make the page a stack of bands.
  -->
  <section class="relative">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-28">
      <h2 class="max-w-2xl text-[clamp(1.9rem,3.6vw,2.6rem)] leading-tight font-extrabold">
        The rest of what it does
      </h2>
      <p class="mt-4 max-w-2xl text-(--muted)">None of it is needed for a first screenshot.</p>

      <ul class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          rest.map((item) => (
            <li>
              <a class="group block" href={item.href}>
                <code class="font-mono text-sm font-medium text-mark">{item.key}</code>
                <h3 class="mt-3 text-lg font-bold group-hover:text-mark">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-(--muted)">{item.body}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Get started. Solid deep red, straight edge, and the footer carries it on. -->
  <section class="tone-red ground-red-ramp relative overflow-hidden">
    <div class="paper-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div
      class="relative mx-auto grid max-w-6xl gap-12 px-6 py-24 sm:py-28 lg:grid-cols-2 lg:gap-20"
    >
      <div>
        <h2 class="text-[clamp(1.9rem,3.6vw,2.6rem)] leading-tight font-extrabold">
          Getting started
        </h2>
        <p class="mt-6 leading-relaxed text-(--muted)">
          Playwright is an optional peer dependency — shotlist does not install it, because its
          postinstall downloads browsers and a project consuming shotlist should not pay for that on
          every install.
        </p>
        <p class="mt-5 leading-relaxed text-(--muted)">
          <code class="font-mono text-sm text-white">npx shotlist --init</code> writes the config and
          a first recipe. Edit them, add one file per screenshot, and shoot the set with{' '}
          <code class="font-mono text-sm text-white">npx shotlist --all --install</code>.
        </p>
        <a
          href="/docs"
          class="mt-8 inline-block rounded-lg bg-paper px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-white"
        >
          Read the docs
        </a>
      </div>

      <div class="min-w-0 lg:pt-2">
        <RecipeCard code={configExample} file="shotlist.config.yaml" />
      </div>
    </div>
  </section>
</Base>
