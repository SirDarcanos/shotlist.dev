---
import { SEO } from 'astro-seo'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import BackToTop from '../components/BackToTop.astro'
import { socialCardFor } from '../lib/social-cards.mjs'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Appended to the site name in the tab, unless this page is the site's front door. */
  bare?: boolean
  /** Utility pages stay useful to visitors without entering the search index. */
  indexable?: boolean
  /** A page view on the measured adoption path. */
  pageEvent?: 'tutorial_viewed'
}

const { title, description, bare = false, indexable = true, pageEvent } = Astro.props
const pathname = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`
const canonical = new URL(pathname, Astro.site).href
const markdownPath = pathname === '/' ? '/index.md' : `${pathname.slice(0, -1)}.md`
const markdownAlternate = new URL(markdownPath, Astro.site).href
const fullTitle = bare ? title : `${title} — shotlist`

/*
 * Priority documentation routes use the matching topic card; every other route keeps the
 * homepage card, so adding a page does not silently declare an image that was never generated.
 */
const topicCard = socialCardFor(pathname)
const card = new URL(topicCard ? `/social/${topicCard.slug}.png` : '/og.png', Astro.site).href
const cardAlt = topicCard
  ? `shotlist documentation — ${topicCard.title}`
  : 'shotlist — annotated UI screenshots, described as data'

const analyticsScript = `
  (() => {
    const pending = []
    const send = (name) => {
      if (window.fathom?.trackEvent) window.fathom.trackEvent(name)
      else pending.push(name)
    }
    const flush = () => {
      if (!window.fathom?.trackEvent) return
      while (pending.length) window.fathom.trackEvent(pending.shift())
    }

    document.getElementById('fathom-script')?.addEventListener('load', flush)
    window.addEventListener('load', flush, { once: true })
    document.addEventListener('DOMContentLoaded', () => {
      if (document.body.dataset.pageEvent === 'tutorial_viewed') send('tutorial_viewed')
    }, { once: true })
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return
      if (event.target.closest('[data-example-download]')) send('example_downloaded')
      else if (event.target.closest('[data-npm-link]')) send('npm_opened')
    })
    document.addEventListener('shotlist:install-command-copied', () => {
      send('install_command_copied')
    })
  })()
`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FAF8F5" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="preload"
      href="/fonts/fraunces-latin-v38.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-v20.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-v24.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      indexable ? (
        <SEO
          title={fullTitle}
          description={description}
          canonical={canonical}
          extend={{ link: [{ rel: 'alternate', type: 'text/markdown', href: markdownAlternate }] }}
          openGraph={{
            basic: { title: fullTitle, type: 'website', image: card, url: canonical },
            optional: { description, siteName: 'shotlist' },
            image: { alt: cardAlt, width: 2400, height: 1260, type: 'image/png' },
          }}
          twitter={{
            card: 'summary_large_image',
            title: fullTitle,
            description,
            image: card,
            imageAlt: cardAlt,
          }}
        />
      ) : (
        <>
          <title>{fullTitle}</title>
          <meta name="description" content={description} />
          <meta name="robots" content="noindex, follow" />
        </>
      )
    }

    {
      /*
      Fathom, in a production build only — a dev server reloading on every save would
      otherwise report itself as traffic. `is:inline` keeps Astro from bundling the tag,
      which is how it keeps the `data-site` the script reads its own site id from.
    */
    }
    {
      import.meta.env.PROD && (
        <>
          <script
            id="fathom-script"
            src="https://cdn.usefathom.com/script.js"
            data-site="HKHUOFHQ"
            defer
            is:inline
          />
          <script is:inline set:html={analyticsScript} />
        </>
      )
    }
  </head>

  <body id="top" class="min-h-screen antialiased" data-page-event={pageEvent}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <BackToTop />
  </body>
</html>
