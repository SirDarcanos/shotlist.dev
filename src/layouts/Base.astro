---
import { SEO } from 'astro-seo'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import BackToTop from '../components/BackToTop.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Appended to the site name in the tab, unless this page is the site's front door. */
  bare?: boolean
}

const { title, description, bare = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const fullTitle = bare ? title : `${title} — shotlist`

/*
 * The card a shared link unfurls into. It is `src/pages/og.astro`, photographed by
 * `npm run shots` and committed — the site advertising itself with the thing it is for.
 */
const card = new URL('/og.png', Astro.site).href
const cardAlt = 'shotlist — annotated UI screenshots, described as data'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FAF8F5" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..900&family=Inter:wght@400..600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title: fullTitle, type: 'website', image: card, url: canonical },
        optional: { description, siteName: 'shotlist' },
        image: { alt: cardAlt, width: 2400, height: 1260, type: 'image/png' },
      }}
      twitter={{
        card: 'summary_large_image',
        title: fullTitle,
        description,
        image: card,
        imageAlt: cardAlt,
      }}
    />

    {
      /*
      Fathom, in a production build only — a dev server reloading on every save would
      otherwise report itself as traffic. `is:inline` keeps Astro from bundling the tag,
      which is how it keeps the `data-site` the script reads its own site id from.
    */
    }
    {
      import.meta.env.PROD && (
        <script src="https://cdn.usefathom.com/script.js" data-site="HKHUOFHQ" defer is:inline />
      )
    }
  </head>

  <body id="top" class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <BackToTop />
  </body>
</html>
