---
import Base from './Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import DocsProvenance from '../components/DocsProvenance.astro'
import { prepareDocsContent } from '../lib/docs-navigation'
import { docsProvenance } from '../lib/docs-provenance.mjs'
import { socialCardFor } from '../lib/social-cards.mjs'
import { docsBreadcrumbs, docsStructuredData } from '../lib/structured-data.mjs'

interface Props {
  title: string
  description: string
  pageEvent?: 'tutorial_viewed'
}

const { title, description, pageEvent } = Astro.props
const path = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`
const provenance = docsProvenance(path)
if (!provenance) throw new Error(`No documentation provenance source for ${path}`)
const { content, headings, pageTitle, howToSteps } = prepareDocsContent(
  await Astro.slots.render('default'),
)
const topicCard = socialCardFor(path)
const image = new URL(topicCard ? `/social/${topicCard.slug}.png` : '/og.png', Astro.site).href
const breadcrumbs = docsBreadcrumbs(path, pageTitle)
const structuredData = docsStructuredData({
  route: path,
  title: pageTitle,
  description,
  provenance,
  image,
  steps: howToSteps,
})

/**
 * The documentation, grouped by what the reader is doing.
 *
 * The four groups are the Diátaxis quadrants: tutorials teach, how-to guides solve a
 * stated problem, reference describes the machinery, and explanation discusses it. A page
 * belongs to exactly one of them.
 *
 * `ready: false` renders the entry without a link.
 */
const sections = [
  {
    label: 'Overview',
    items: [{ href: '/docs/', label: 'Documentation', ready: true }],
  },
  {
    label: 'Tutorials',
    items: [
      { href: '/docs/tutorials/first-screenshot/', label: 'Your first screenshot', ready: true },
      {
        href: '/docs/tutorials/keeping-a-screenshot-current/',
        label: 'Keeping a screenshot current',
        ready: true,
      },
      {
        href: '/docs/tutorials/document-a-wordpress-site/',
        label: "Document a client's WordPress site",
        ready: true,
      },
    ],
  },
  {
    label: 'How-to guides',
    items: [
      { href: '/docs/how-to/install/', label: 'Add shotlist to a project', ready: true },
      { href: '/docs/how-to/start-the-site/', label: 'Start the site automatically', ready: true },
      { href: '/docs/how-to/lint/', label: 'Check files without a browser', ready: true },
      {
        href: '/docs/how-to/drive-a-page/',
        label: 'Capture a page after interaction',
        ready: true,
      },
      { href: '/docs/how-to/iframes/', label: 'Capture inside an iframe', ready: true },
      { href: '/docs/how-to/share-setup/', label: 'Share setup between recipes', ready: true },
      { href: '/docs/how-to/sign-in/', label: 'Capture a page behind a sign-in', ready: true },
      { href: '/docs/how-to/annotate-an-image/', label: 'Annotate an existing image', ready: true },
      { href: '/docs/how-to/hide-changing-data/', label: 'Hide data that changes', ready: true },
      {
        href: '/docs/how-to/undo-what-a-shot-changed/',
        label: 'Undo what a shot changed',
        ready: true,
      },
      { href: '/docs/how-to/label-font/', label: 'Use a custom label font', ready: true },
      { href: '/docs/how-to/run-in-ci/', label: 'Run shotlist in CI', ready: true },
    ],
  },
  {
    label: 'Reference',
    items: [
      { href: '/docs/reference/cli/', label: 'Command line', ready: true },
      { href: '/docs/reference/configuration/', label: 'Configuration file', ready: true },
      { href: '/docs/reference/recipe/', label: 'Recipe file', ready: true },
      { href: '/docs/reference/steps/', label: 'Steps', ready: true },
      { href: '/docs/reference/queries/', label: 'Queries', ready: true },
      { href: '/docs/reference/callouts/', label: 'Callouts and masks', ready: true },
      { href: '/docs/reference/macros-and-data/', label: 'Macros and data files', ready: true },
    ],
  },
  {
    label: 'Explanation',
    items: [
      { href: '/docs/explanation/no-code/', label: 'Why recipes cannot run code', ready: true },
      {
        href: '/docs/explanation/playwright/',
        label: 'Why Playwright is separate',
        ready: true,
      },
      {
        href: '/docs/explanation/durable-queries/',
        label: 'Queries that survive a redesign',
        ready: true,
      },
      { href: '/docs/explanation/placement/', label: 'How labels are placed', ready: true },
      {
        href: '/docs/explanation/security-model/',
        label: 'What a configuration can do',
        ready: true,
      },
      { href: '/docs/explanation/image-drift/', label: 'Why screenshots drift', ready: true },
    ],
  },
]
---

<Base title={title} description={description} pageEvent={pageEvent} structuredData={structuredData}>
  <div
    class="docs-page mx-auto max-w-6xl gap-12 px-6 py-12 md:grid md:grid-cols-[13rem_minmax(0,1fr)] md:py-16"
  >
    <!--
      Below `lg` this is a bar that stays with you rather than a list at the top of the
      page: the reference is one document in eleven parts, and reaching part four used to
      mean scrolling back through part three to find the way there.
    -->
    <div
      id="docs-nav"
      class="sticky top-[65px] z-30 mb-10 -mx-6 border-b border-rule bg-paper/95 px-6 py-3 backdrop-blur-sm md:top-24 md:z-auto md:mx-0 md:mb-0 md:self-start md:border-0 md:bg-transparent md:p-0 md:backdrop-blur-none"
    >
      <details id="docs-nav-disclosure" class="md:hidden">
        <summary
          aria-controls="documentation-links"
          class="flex cursor-pointer list-none items-center justify-between font-mono text-xs tracking-wider text-muted uppercase [&::-webkit-details-marker]:hidden"
        >
          Documentation
          <svg
            class="chevron size-4 transition-transform"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
      </details>

      <nav
        id="documentation-links"
        class="max-h-[70vh] overflow-y-auto pt-5 md:max-h-[calc(100vh-8rem)] md:pt-0"
        aria-label="Documentation"
      >
        {
          sections.map((section) => (
            <div class="mb-7">
              <p class="mb-3 font-mono text-[0.6875rem] tracking-wider text-muted uppercase">
                {section.label}
              </p>
              <ul class="text-sm">
                {section.items.map((item) =>
                  item.ready ? (
                    <li>
                      <a
                        href={item.href}
                        aria-current={path === item.href ? 'page' : undefined}
                        class:list={[
                          'block border-l-2 py-1.5 pl-3 transition-colors',
                          path === item.href
                            ? 'border-mark font-medium text-mark'
                            : 'border-rule text-muted hover:border-rule-strong hover:text-ink',
                        ]}
                      >
                        {item.label}
                      </a>
                      {path === item.href && headings.length > 1 && (
                        <ul class="page-toc">
                          {headings.map((heading) => (
                            <li>
                              <a href={`#${heading.id}`}>{heading.label}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ) : (
                    <li>
                      <span class="block cursor-default border-l-2 border-rule py-1.5 pl-3 text-muted opacity-45">
                        {item.label}
                      </span>
                    </li>
                  ),
                )}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="min-w-0 max-w-2xl">
      <Breadcrumbs crumbs={breadcrumbs} />
      <article>
        <Fragment set:html={content} />
        <DocsProvenance {...provenance} />
      </article>
    </div>
  </div>
</Base>

<style>
  details[open] .chevron {
    transform: rotate(180deg);
  }

  /* The native open state controls the adjacent list, so desktop does not need an open disclosure. */
  details:not([open]) + nav {
    display: none;
  }

  @media (min-width: 48rem) {
    #docs-nav > nav {
      display: block;
    }
  }

  /*
   * The page's own headings, under the entry for the page they are on.
   *
   * Set apart from the page links rather than matching them: a step down in size, a rule
   * half the weight, and indented past the border those links carry. Sharing their
   * styling made a heading look like another page to go to.
   */
  :global(.docs-page article h2[id]) {
    scroll-margin-top: 8rem;
  }

  :global(.page-toc) {
    border-left: 2px solid var(--color-rule);
    padding-block: 0.125rem;
  }

  :global(.page-toc a) {
    display: block;
    padding: 0.1875rem 0 0.1875rem 1.625rem;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-muted);
    transition: color 0.15s;
  }

  :global(.page-toc a:hover) {
    color: var(--color-ink);
  }

  :global(.page-toc a[data-here]) {
    color: var(--color-mark);
    font-weight: 500;
  }
</style>

<script>
  const headings = [...document.querySelectorAll<HTMLHeadingElement>('main h2')]
  const links = new Map(
    headings.map((heading) => [
      heading,
      document.querySelector<HTMLAnchorElement>(`.page-toc a[href="#${heading.id}"]`),
    ]),
  )

  if (headings.length > 1) {
    // The active section is the last heading above the reading line, including after a direct fragment arrival.
    const mark = () => {
      const bottom = window.scrollY + window.innerHeight >= document.body.scrollHeight - 2
      const current = bottom
        ? headings[headings.length - 1]
        : (headings.filter((heading) => heading.getBoundingClientRect().top < 120).pop() ??
          headings[0])
      for (const [heading, link] of links) {
        if (heading === current) link?.setAttribute('data-here', '')
        else link?.removeAttribute('data-here')
      }
    }
    mark()
    window.addEventListener('scroll', mark, { passive: true })
    window.addEventListener('resize', mark)
  }
</script>
