# Cloudflare Pages response headers.
# See https://developers.cloudflare.com/pages/configuration/headers/
#
# No Cache-Control on /*: Pages joins duplicate header values with a comma, so one
# here would merge into the /_astro/* rule below and defeat it. The Pages default
# for HTML is already max-age=0, must-revalidate.

# Security headers on every response. style-src allows inline because the pages
# carry a few hundred style attributes.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdn.usefathom.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.usefathom.com; font-src 'self'; connect-src 'self' https://cdn.usefathom.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Content-hashed build assets never change under a given URL — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames carry their upstream version, so deployed copies are immutable too.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
